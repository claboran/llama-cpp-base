        "h": 4,
        "w": 5,
        "x": 19,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service) (increase(llamacpp:prompt_tokens_total{job=\"llama\",service=~\"$service\"}[$__range]) + increase(llamacpp:tokens_predicted_total{job=\"llama\",service=~\"$service\"}[$__range]))",
          "legendFormat": "{{service}}",
          "refId": "A",
          "range": false,
