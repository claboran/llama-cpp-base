        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service) (rate(llamacpp:tokens_predicted_total{job=\"llama\",service=~\"$service\"}[$__rate_interval])) / (sum by (service) (rate(llamacpp:tokens_predicted_seconds_total{job=\"llama\",service=~\"$service\"}[$__rate_interval])) > 0)",
          "legendFormat": "{{service}}",
          "refId": "A",
          "range": true
