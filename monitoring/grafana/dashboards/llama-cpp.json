      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "id": 12,
      "title": "Prompt cache hit ratio",
      "description": "Share of prompt tokens served from the prompt cache instead of being evaluated.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 14
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service) (rate(llamacpp:prompt_tokens_cached_total{job=\"llama\",service=~\"$service\"}[$__rate_interval])) / ((sum by (service) (rate(llamacpp:prompt_tokens_cached_total{job=\"llama\",service=~\"$service\"}[$__rate_interval])) + sum by (service) (rate(llamacpp:prompt_tokens_total{job=\"llama\",service=~\"$service\"}[$__rate_interval]))) > 0)",
          "legendFormat": "{{service}}",
          "refId": "A",
          "range": true
