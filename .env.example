# --- image build ---
LLAMA_CPP_REF=v1.0.0
CUDA_VERSION=13.0.3
CUDA_ARCHS=121

# --- network / security ---
# Ports are published on *_BIND (0.0.0.0 = all interfaces, 127.0.0.1 = this host only).
# Set API_KEY before exposing the services; clients send "Authorization: Bearer <key>".
# Generate one with: openssl rand -hex 32
API_KEY=
# Allowed browser origins (CORS): "*" = any, "localhost" = same-origin only, or a comma-separated list
CORS_ORIGINS=*

# --- models ---
MODELS_DIR=./models

# chat (Gemma 4 26B-A4B)
CHAT_MODEL=google_gemma-4-26B-A4B-it-Q4_K_M.gguf
CHAT_ALIAS=gemma-4-26b-a4b
CHAT_CTX=65536
CHAT_PARALLEL=1
# f16 | q8_0 | q4_0 | f8_e4m3 (KV cache type)
CHAT_CACHE_TYPE=f16
CHAT_BIND=0.0.0.0
CHAT_PORT=8099

# competitor: Qwen3.8-27B (dense), compose.qwen.yaml / make up-qwen
QWEN_MODEL=Qwen3.8-27B-Q4_K_M.gguf
QWEN_ALIAS=qwen3.8-27b
QWEN_CTX=65536
QWEN_PARALLEL=1
QWEN_CACHE_TYPE=f16
# speculative decoding via the model's built-in MTP layers (none = off); draft tokens per step:
# 4 is the best all-rounder, 8 is faster on code but slower on prose
QWEN_SPEC_TYPE=draft-mtp
QWEN_DRAFT_N=4
QWEN_BIND=0.0.0.0
QWEN_PORT=8098

# embeddings (bge-m3, 1024-dim)
EMBED_MODEL=bge-m3-q8_0.gguf
EMBED_ALIAS=bge-m3
EMBED_CTX=8192
EMBED_PARALLEL=1
EMBED_BIND=0.0.0.0
EMBED_PORT=8901

# --- monitoring: Prometheus + Grafana (compose.monitoring.yaml / make up-monitoring) ---
# Bound to localhost by default; reach them via SSH tunnel or set MONITORING_BIND.
MONITORING_BIND=127.0.0.1
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=30d
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
# Change before exposing Grafana (default admin/admin asks for a new password on first login)
GRAFANA_ADMIN_PASSWORD=admin
# Bearer token Prometheus uses for /metrics. Empty = API_KEY. Set it if API_KEY holds several
# comma-separated keys (use one of them).
METRICS_API_KEY=
