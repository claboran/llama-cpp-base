# --- image build ---
LLAMA_CPP_REF=v1.0.0
CUDA_VERSION=13.0.3
CUDA_ARCHS=121

# --- network / security ---
# Ports are published on *_BIND (0.0.0.0 = all interfaces, 127.0.0.1 = this host only).
# Set API_KEY before exposing the services; clients send "Authorization: Bearer <key>".
# Generate one with: openssl rand -hex 32
API_KEY=
# Allowed browser origins (CORS): "*" = any, "localhost" = same-origin only, or a comma-separated list
CORS_ORIGINS=*

# --- models ---
MODELS_DIR=./models

# chat (Gemma 4 26B-A4B)
CHAT_MODEL=google_gemma-4-26B-A4B-it-Q4_K_M.gguf
CHAT_ALIAS=gemma-4-26b-a4b
CHAT_CTX=65536
CHAT_PARALLEL=1
# f16 | q8_0 | q4_0 | f8_e4m3 (KV cache type)
CHAT_CACHE_TYPE=f16
CHAT_BIND=0.0.0.0
CHAT_PORT=8099

# embeddings (bge-m3, 1024-dim)
EMBED_MODEL=bge-m3-q8_0.gguf
EMBED_ALIAS=bge-m3
EMBED_CTX=8192
EMBED_PARALLEL=1
EMBED_BIND=0.0.0.0
EMBED_PORT=8901
